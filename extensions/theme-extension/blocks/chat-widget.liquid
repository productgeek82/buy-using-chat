{% comment %}
  Chat Widget — AI shopping assistant powered by Claude + Shopify Storefront MCP tools.
  App Proxy: /apps/chat-proxy → app backend /api/chat
{% endcomment %}

<div id="buc-widget-root">
  <button id="buc-toggle" aria-label="Open shop assistant" aria-expanded="false">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2Z" fill="currentColor"/>
    </svg>
  </button>

  <div id="buc-panel" role="dialog" aria-modal="true" aria-label="{{ block.settings.widget_title | escape }}" hidden>
    <div id="buc-header">
      <span>{{ block.settings.widget_title | escape }}</span>
      <button id="buc-close" aria-label="Close">&#x2715;</button>
    </div>
    <div id="buc-messages"></div>
    <form id="buc-form" autocomplete="off">
      <input id="buc-input" type="text"
             placeholder="{{ block.settings.placeholder | escape }}"
             aria-label="Ask the shop assistant" required />
      <button type="submit" aria-label="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" fill="currentColor"/>
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  #buc-widget-root {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  #buc-toggle {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: {{ block.settings.accent_color }};
    color: #fff; border: none; cursor: pointer;
    box-shadow: 0 4px 16px rgba(0,0,0,.24);
    display: flex; align-items: center; justify-content: center;
    transition: transform .15s, box-shadow .15s;
    margin-left: auto;
  }
  #buc-toggle:hover { transform: scale(1.06); box-shadow: 0 6px 20px rgba(0,0,0,.3); }
  #buc-panel {
    position: absolute; bottom: 68px; right: 0;
    width: 340px; max-height: 520px;
    background: #fff; border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0,0,0,.18);
    display: flex; flex-direction: column; overflow: hidden;
  }
  #buc-panel[hidden] { display: none; }
  #buc-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px;
    background: {{ block.settings.accent_color }};
    color: #fff; font-weight: 600; font-size: 15px;
  }
  #buc-close { background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; padding: 0 2px; }
  #buc-messages {
    flex: 1; overflow-y: auto; padding: 14px 12px;
    display: flex; flex-direction: column; gap: 10px; scroll-behavior: smooth;
  }
  .buc-bubble {
    padding: 10px 13px; border-radius: 12px;
    font-size: 14px; line-height: 1.5; max-width: 88%; word-wrap: break-word;
  }
  .buc-bubble.user {
    background: {{ block.settings.accent_color }}; color: #fff;
    align-self: flex-end; border-bottom-right-radius: 4px;
  }
  .buc-bubble.bot {
    background: #f2f2f7; color: #111;
    align-self: flex-start; border-bottom-left-radius: 4px;
    white-space: pre-wrap;
  }
  .buc-bubble.error {
    background: #fff0f0; color: #c00;
    align-self: flex-start; border: 1px solid #f8c8c8;
  }
  .buc-typing {
    display: flex; gap: 4px; padding: 10px 13px;
    background: #f2f2f7; border-radius: 12px; border-bottom-left-radius: 4px;
    align-self: flex-start;
  }
  .buc-typing span {
    width: 7px; height: 7px; border-radius: 50%;
    background: #999; animation: buc-bounce .9s infinite ease-in-out;
  }
  .buc-typing span:nth-child(2) { animation-delay: .15s; }
  .buc-typing span:nth-child(3) { animation-delay: .30s; }
  @keyframes buc-bounce {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(-6px); }
  }
  .buc-card {
    background: #fafafa; border: 1px solid #e8e8e8;
    border-radius: 12px; padding: 12px;
    display: flex; gap: 10px; align-self: flex-start;
    width: 100%; box-sizing: border-box;
  }
  .buc-card img { width: 56px; height: 56px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
  .buc-card-info { flex: 1; display: flex; flex-direction: column; gap: 4px; }
  .buc-card-title { font-size: 13px; font-weight: 600; color: #111; line-height: 1.3; }
  .buc-card-price { font-size: 13px; color: #555; }
  .buc-buy-btn {
    margin-top: 6px; padding: 7px 12px;
    background: {{ block.settings.accent_color }}; color: #fff;
    border: none; border-radius: 8px; font-size: 13px; font-weight: 600;
    cursor: pointer; align-self: flex-start; transition: opacity .15s;
  }
  .buc-buy-btn:hover { opacity: .85; }
  .buc-buy-btn:disabled { opacity: .5; cursor: default; }
  #buc-form {
    display: flex; padding: 10px 12px; gap: 8px; border-top: 1px solid #eee;
  }
  #buc-input {
    flex: 1; border: 1px solid #ddd; border-radius: 20px;
    padding: 9px 14px; font-size: 14px; outline: none; transition: border-color .15s;
  }
  #buc-input:focus { border-color: {{ block.settings.accent_color }}; }
  #buc-form button[type="submit"] {
    width: 38px; height: 38px; border-radius: 50%;
    background: {{ block.settings.accent_color }}; color: #fff; border: none;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: opacity .15s;
  }
  #buc-form button[type="submit"]:hover { opacity: .85; }
  @media (max-width: 420px) { #buc-panel { width: calc(100vw - 32px); right: 0; } }
</style>

<script>
(function () {
  "use strict";

  var PROXY = "/apps/chat-proxy";

  var toggle   = document.getElementById("buc-toggle");
  var panel    = document.getElementById("buc-panel");
  var closeBtn = document.getElementById("buc-close");
  var messages = document.getElementById("buc-messages");
  var form     = document.getElementById("buc-form");
  var input    = document.getElementById("buc-input");

  // Conversation history sent to the server each turn
  var history = [];

  // ── Panel open / close ───────────────────────────────────────────────────
  toggle.addEventListener("click", function () {
    var isOpen = !panel.hidden;
    panel.hidden = isOpen;
    toggle.setAttribute("aria-expanded", String(!isOpen));
    if (!isOpen) {
      if (history.length === 0) addBubble("Hi! What are you looking for today?", "bot");
      input.focus();
    }
  });
  closeBtn.addEventListener("click", function () {
    panel.hidden = true;
    toggle.setAttribute("aria-expanded", "false");
  });

  // ── DOM helpers ──────────────────────────────────────────────────────────
  function addBubble(text, type) {
    var el = document.createElement("div");
    el.className = "buc-bubble " + type;
    el.textContent = text;
    messages.appendChild(el);
    scrollDown();
    return el;
  }

  function addTyping() {
    var el = document.createElement("div");
    el.className = "buc-typing";
    el.innerHTML = "<span></span><span></span><span></span>";
    messages.appendChild(el);
    scrollDown();
    return el;
  }

  function removeEl(el) { if (el && el.parentNode) el.parentNode.removeChild(el); }
  function scrollDown() { messages.scrollTop = messages.scrollHeight; }

  function renderProductCard(product) {
    var card = document.createElement("div");
    card.className = "buc-card";

    if (product.imageUrl) {
      var img = document.createElement("img");
      img.src = product.imageUrl;
      img.alt = product.title || "";
      card.appendChild(img);
    }

    var info = document.createElement("div");
    info.className = "buc-card-info";

    var title = document.createElement("div");
    title.className = "buc-card-title";
    title.textContent = product.title || "Product";
    info.appendChild(title);

    if (product.price != null) {
      var price = document.createElement("div");
      price.className = "buc-card-price";
      price.textContent = new Intl.NumberFormat("en-US", {
        style: "currency", currency: product.currency || "USD"
      }).format(product.price);
      info.appendChild(price);
    }

    if (product.variantId && product.availableForSale !== false) {
      var btn = document.createElement("button");
      btn.className = "buc-buy-btn";
      btn.textContent = "Buy Now";
      btn.addEventListener("click", function () { buyNow(product.variantId, btn); });
      info.appendChild(btn);
    }

    card.appendChild(info);
    messages.appendChild(card);
    scrollDown();
  }

  // ── Chat submit ──────────────────────────────────────────────────────────
  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    var userText = input.value.trim();
    if (!userText) return;
    input.value = "";

    addBubble(userText, "user");

    // Add to conversation history
    history.push({ role: "user", content: userText });

    var typing = addTyping();

    try {
      var res = await fetch(PROXY, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history }),
      });

      var data = await res.json();
      removeEl(typing);

      if (data.error) {
        addBubble("Error: " + data.error, "error");
        history.pop(); // remove failed user message from history
        return;
      }

      // Show Claude's text reply
      if (data.reply) {
        addBubble(data.reply, "bot");
        history.push({ role: "assistant", content: data.reply });
      }

      // Show product cards returned by the search tool
      if (data.products && data.products.length > 0) {
        data.products.forEach(renderProductCard);
      }

      // If Claude triggered a checkout, redirect immediately
      if (data.checkoutUrl) {
        addBubble("Redirecting you to checkout…", "bot");
        setTimeout(function () { window.location.href = data.checkoutUrl; }, 700);
      }

    } catch (err) {
      removeEl(typing);
      addBubble("Something went wrong. Please try again.", "error");
      history.pop();
    }
  });

  // ── Buy Now (direct checkout, no LLM call) ───────────────────────────────
  async function buyNow(variantId, btn) {
    btn.disabled = true;
    btn.textContent = "Creating checkout…";
    var typing = addTyping();

    try {
      var res = await fetch(PROXY, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ intent: "checkout", variantId: variantId }),
      });
      var data = await res.json();
      removeEl(typing);

      if (!data.continueUrl) throw new Error(data.error || "No checkout URL returned");
      addBubble("Redirecting you to checkout…", "bot");
      setTimeout(function () { window.location.href = data.continueUrl; }, 600);
    } catch (err) {
      removeEl(typing);
      btn.disabled = false;
      btn.textContent = "Buy Now";
      addBubble("Checkout failed: " + err.message, "error");
    }
  }
})();
</script>

{% schema %}
{
  "name": "Chat Widget",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "widget_title",
      "label": "Widget title",
      "default": "Shop Assistant"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Ask me anything…"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#1a1a2e"
    }
  ]
}
{% endschema %}
